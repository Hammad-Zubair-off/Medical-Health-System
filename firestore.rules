rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role;
    }

    function hasRole(r) {
      return isSignedIn() && myRole() == r;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function userRef() {
      return /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    function doctorOwnsDoc() {
      return isSignedIn()
        && resource.data.keys().hasAny(["userid"])
        && resource.data.userid == userRef();
    }

    function isLinkedPatient() {
      return isSignedIn()
        && resource.data.keys().hasAny(["userId"])
        && resource.data.userId == request.auth.uid;
    }

    function appointmentReadable() {
      return isAdmin()
        || (isSignedIn()
            && resource.data.keys().hasAny(["doctorUserId"])
            && (resource.data.doctorUserId == userRef()
                || resource.data.doctorUserId == request.auth.uid))
        || (isSignedIn()
            && resource.data.keys().hasAny(["UserPatientID"])
            && resource.data.UserPatientID != null
            && (resource.data.UserPatientID == userRef()
                || resource.data.UserPatientID == request.auth.uid))
        || (isSignedIn()
            && resource.data.keys().hasAny(["patientId"])
            && resource.data.patientId is string
            && get(/databases/$(database)/documents/Patient/$(resource.data.patientId)).data.userId
                == request.auth.uid);
    }

    function appointmentCreateAllowed() {
      return isAdmin()
        || hasRole("doctor")
        || (hasRole("patient")
            && request.resource.data.keys().hasAny(["UserPatientID"])
            && request.resource.data.UserPatientID == userRef());
    }

    match /Users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Self-serve patient signup, or admin provisioning a patient/doctor login.
      allow create: if isAdmin()
        && request.resource.data.uid == uid
        && (request.resource.data.role == "patient"
            || request.resource.data.role == "doctor")
        || (isSelf(uid)
            && request.resource.data.role == "patient"
            && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        || (isSelf(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /Doctor/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || doctorOwnsDoc();
    }

    // Patient clinical data lives here, not on Users — this is what lets a
    // doctor read their patients' names/contact info without being isSelf or
    // isAdmin on the (private) Users doc. See docs/DATA_MIGRATION_PLAN.md Step 0.
    match /Patient/{id} {
      allow read: if isAdmin() || hasRole("doctor") || isLinkedPatient();
      allow create: if isAdmin() || hasRole("doctor");
      // The linked patient may only touch a narrow self-service field set —
      // never their own status or primaryDoctorId.
      allow update: if isAdmin()
        || hasRole("doctor")
        || (isLinkedPatient()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["phoneNumber", "address", "photoUrl", "updated", "updatedBy"]));
      allow delete: if isAdmin();
    }

    match /Specialization/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /Appointment/{id} {
      allow read: if appointmentReadable();
      // Walk-in booking: admin/doctor may create with patientId and null UserPatientID.
      allow create: if appointmentCreateAllowed()
        && request.resource.data.keys().hasAny(["patientId"]);
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.keys().hasAny(["doctorUserId"])
            && (resource.data.doctorUserId == userRef()
                || resource.data.doctorUserId == request.auth.uid))
        || (hasRole("patient")
            && appointmentReadable()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "cancel_reason", "updated", "updatedBy"]));
      allow delete: if isAdmin();
    }

    match /Review/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole("doctor") || hasRole("patient");
    }

    match /Prescription/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.doctorUserId == request.auth.uid)
        || (isSignedIn() && resource.data.patientUserId == request.auth.uid);
      allow create: if isAdmin()
        || (hasRole("doctor") && request.resource.data.doctorUserId == request.auth.uid);
      allow update: if isAdmin()
        || (hasRole("doctor") && resource.data.doctorUserId == request.auth.uid);
      allow delete: if false;   // clinical record — cancel, never delete
    }

    // Finance — money fields are admin-written only. Patients may read their
    // own invoices/payments; they must never write amountPaid/total/status.
    match /Invoice/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.patientUserId == request.auth.uid)
        || (isSignedIn() && resource.data.doctorUserId == request.auth.uid);
      allow create, update: if isAdmin()
        || (hasRole("doctor")
            && request.resource.data.doctorUserId == request.auth.uid);
      allow delete: if false;
    }

    match /Payment/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.patientUserId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /Expense/{id} {
      allow read, write: if isAdmin();
    }

    match /ExpenseCategory/{id} {
      allow read, write: if isAdmin();
    }

    match /Counter/{id} {
      allow read, write: if isAdmin();
    }

    // Clinic misc — signed-in read, admin write
    match /Asset/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /Location/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /Service/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // HRM — payroll is private (admin or own staffUserId). Leave create pins
    // status == "pending" for self-requests; only admin may approve/reject.
    function isStaffRole() {
      return isAdmin() || hasRole("doctor");
    }

    match /Staff/{id} {
      allow read: if isStaffRole();
      allow write: if isAdmin();
    }

    match /Department/{id} {
      allow read: if isStaffRole();
      allow write: if isAdmin();
    }

    match /Designation/{id} {
      allow read: if isStaffRole();
      allow write: if isAdmin();
    }

    match /LeaveType/{id} {
      allow read: if isStaffRole();
      allow write: if isAdmin();
    }

    match /Holiday/{id} {
      // Signed-in read so patient booking can enforce clinic-wide closures via isHoliday().
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /Attendance/{id} {
      allow read: if isStaffRole();
      allow write: if isAdmin();
    }

    match /Leave/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.staffUserId == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.staffUserId == request.auth.uid
            && request.resource.data.status == "pending");
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /Payroll/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.staffUserId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Clinic configuration (settings UI). Lookups soft-delete only.
    match /ClinicSettings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /CancellationReason/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /TaxRate/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /Currency/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /BankAccount/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // File Manager metadata (assets live in Cloudinary). Soft-delete only.
    match /FileObject/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (isSignedIn() && request.auth.uid in resource.data.sharedWith);

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.sizeBytes is number
        && request.resource.data.sizeBytes == int(request.resource.data.sizeBytes)
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 10485760
        && request.resource.data.publicId is string
        && request.resource.data.secureUrl is string;

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.publicId == resource.data.publicId
            && request.resource.data.secureUrl == resource.data.secureUrl);

      allow delete: if false;
    }

    match /FileFolder/{id} {
      allow read, update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
